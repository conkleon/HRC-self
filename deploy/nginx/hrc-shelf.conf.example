# Host nginx site for the HRC Shelf stack.
#
# Install on the server (not in Docker), e.g. as
# /etc/nginx/sites-available/hrc-shelf.conf, replace the two hostnames and the
# certificate paths, then: nginx -t && systemctl reload nginx
#
#   assets.example.org           -> Shelf             (127.0.0.1:APP_PORT)
#   supabase.assets.example.org  -> Supabase gateway  (127.0.0.1:GATEWAY_PORT)
#
# The certificates below follow the certbot layout; any ACME client works.
# `listen ... http2` works on every nginx; on 1.25.1+ it logs a deprecation
# notice and can be replaced by a separate `http2 on;` line.

# ---------------------------------------------------------------------------
# HTTP: ACME challenges, everything else redirected to HTTPS
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name assets.example.org supabase.assets.example.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Shelf web app
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name assets.example.org;

    ssl_certificate     /etc/letsencrypt/live/assets.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/assets.example.org/privkey.pem;

    # Image and CSV uploads go through Shelf before reaching storage.
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, never append: Shelf trusts the leftmost X-Forwarded-For
        # entry for rate limiting, so a client-supplied value must not survive.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;

        # Exports and PDF generation can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }
}

# ---------------------------------------------------------------------------
# Supabase API gateway (auth + storage)
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name supabase.assets.example.org;

    ssl_certificate     /etc/letsencrypt/live/supabase.assets.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/supabase.assets.example.org/privkey.pem;

    # Matches FILE_SIZE_LIMIT on the storage service.
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}
