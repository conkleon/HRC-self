# =============================================================================
# HRC Shelf stack: the one environment file for every service
# =============================================================================
# `./scripts/generate-secrets.sh` copies this file to `deploy/.env` and fills
# the empty secrets below. Docker Compose reads `deploy/.env` for the Supabase
# services and passes all of it to the Shelf container, so any optional Shelf
# variable from the repo's root .env.example can be added there as well.
#
# Values that Shelf and Supabase share (database URL, Supabase URL and keys,
# SMTP sender) are derived in docker-compose.yml. Do not set DATABASE_URL,
# DIRECT_URL, SUPABASE_URL, SUPABASE_ANON_PUBLIC, SUPABASE_SERVICE_ROLE or
# SMTP_FROM here: compose overrides them.

# -----------------------------------------------------------------------------
# Public URLs (HTTPS terminated by the host nginx)
# -----------------------------------------------------------------------------
# Shelf web app. No trailing slash.
SERVER_URL=https://assets.example.org
# Supabase API gateway (login and file storage). Browsers load images from it,
# so it must be publicly reachable. No trailing slash.
SUPABASE_PUBLIC_URL=https://supabase.assets.example.org
# Hostname part of SUPABASE_PUBLIC_URL. Shelf's server-side calls to Supabase
# then go straight to the host nginx instead of looping out through the
# internet. Leave empty if the server can reach its own public hostname.
SUPABASE_HOST=supabase.assets.example.org

# -----------------------------------------------------------------------------
# Loopback ports the host nginx proxies to (all bound to 127.0.0.1)
# -----------------------------------------------------------------------------
APP_PORT=3000
GATEWAY_PORT=8000
# Supabase Studio. Reach it with: ssh -L 54323:127.0.0.1:54323 <server>
STUDIO_PORT=54323

# -----------------------------------------------------------------------------
# Secrets: leave empty and run ./scripts/generate-secrets.sh
# -----------------------------------------------------------------------------
# Database password, used by Postgres and all internal Supabase roles. Must be
# URL-safe (it is embedded in connection strings). Fixed after first start.
POSTGRES_PASSWORD=
# Supabase JWT secret (at least 32 characters) and the two API keys signed
# with it. Regenerate all three together, never one alone.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY=3600
# Encrypts connection strings stored by Supabase Studio.
PG_META_CRYPTO_KEY=
# Shelf secrets.
SESSION_SECRET=
INVITE_TOKEN_SECRET=
FINGERPRINT=

# -----------------------------------------------------------------------------
# Email (SMTP), shared by Supabase Auth (login codes) and Shelf (notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.org
# 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_PORT=465
SMTP_USER=assets@example.org
SMTP_PWD=change-me
SMTP_SENDER_EMAIL=assets@example.org
SMTP_SENDER_NAME="Hellenic Red Cross Assets"

# Subjects of the Supabase Auth emails (bodies live in supabase/templates/).
# AUTH_SUBJECT_CONFIRMATION="Confirm your account"
# AUTH_SUBJECT_MAGIC_LINK="Your login code"
# AUTH_SUBJECT_RECOVERY="Reset your password"
# AUTH_SUBJECT_INVITE="You have been invited"
# AUTH_SUBJECT_EMAIL_CHANGE="Confirm your new email"
# Max auth emails per hour across the instance.
# AUTH_RATE_LIMIT_EMAIL_SENT=100

# -----------------------------------------------------------------------------
# Shelf application
# -----------------------------------------------------------------------------
# Product name shown instead of "Shelf" (tab titles, login, emails, PDFs).
APP_NAME="HRC Assets"
# Server name: shown in the Companion app and under the logo on the login
# screen when it differs from APP_NAME.
INSTANCE_NAME="Hellenic Red Cross"
# Accent color replacing Shelf orange, as a hex value. Pick one dark enough
# for white button text; the server logs a warning if it is too light.
BRAND_PRIMARY_COLOR="#CF000C"
# Icon and login background: put icon.png and login-bg.jpg in deploy/branding.
# See apps/docs/instance-branding.md.

# All features unlocked, no Stripe subscription required.
ENABLE_PREMIUM_FEATURES=false
# Keep false until the first administrator has signed up, then set to true so
# new people can only join by invitation (restart the shelf service).
DISABLE_SIGNUP=false
# SAML SSO needs extra Supabase Auth configuration; off until that is set up.
DISABLE_SSO=true
ENABLE_SCIM=false
SEND_ONBOARDING_EMAIL=false

# Required by Shelf. Maps stay blank without a real MapTiler key.
MAPTILER_TOKEN=disabled
GEOCODING_USER_AGENT="Hellenic Red Cross Assets (https://assets.example.org)"

# Where admin notifications and user support requests are sent.
ADMIN_EMAIL=it@example.org
SUPPORT_EMAIL=it@example.org

# Optional. Prisma connection pool size for the Shelf container.
# DB_CONNECTION_LIMIT=10

# Optional. FullCalendar premium licence for the bookings timeline view.
# FULL_CALENDAR_LICENSE_KEY=

# Optional. Sentry error reporting.
# SENTRY_DSN=

# Optional. Supabase Studio display names.
# STUDIO_DEFAULT_ORGANIZATION="Hellenic Red Cross"
# STUDIO_DEFAULT_PROJECT="Shelf"
